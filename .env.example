# Copy to .env and fill in values for local/AWS runs.
# Do not commit real secrets.

PYTHONPATH=/app
AWS_DEFAULT_REGION=eu-west-2

# Optional: if the dashboard calls the FastAPI service over HTTP
API_URL=http://localhost:8000

# Optional overrides (defaults are already set in code/config)
DATA_PATH=dataset/ecommerce_sessions.csv
MODEL_DIR=src/models
THRESHOLD=0.5
